generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id         String   @id
  name       String
  age        Int
  photoUrl   String
  bio        String
  city       String
  interests  String
  isDemoUser Boolean  @default(false)
  createdAt  DateTime @default(now())

  swipesFrom Swipe[]  @relation("SwipesFrom")
  swipesTo   Swipe[]  @relation("SwipesTo")
  matchesA   Match[]  @relation("MatchesA")
  matchesB   Match[]  @relation("MatchesB")
}

model Swipe {
  id        Int      @id @default(autoincrement())
  fromId    String
  toId      String
  action    String   // LIKE or PASS
  createdAt DateTime @default(now())

  from      Profile  @relation("SwipesFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        Profile  @relation("SwipesTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
}

model Match {
  id        Int      @id @default(autoincrement())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA     Profile  @relation("MatchesA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     Profile  @relation("MatchesB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
}
